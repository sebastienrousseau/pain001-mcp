{
  // Markdown style for the docs-lint job. Length and inline HTML are not
  // linted (the README uses centred HTML headers); the rules that remain
  // catch real defects.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD029": false,
    "MD036": false,
    "MD040": false,
    "MD046": false,
    "MD049": false,
    "MD050": false
  },
  "ignores": [
    "docs/readme-template.md",
    "node_modules/**",
    ".venv/**",
    "target/**",
    "docs/_build/**",
    "site/**",
    "htmlcov/**",
    "CHANGELOG.md",
    "releases/**"
  ]
}
