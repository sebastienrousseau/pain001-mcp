# Runtime dependencies of pain001-mcp, mirroring
# [tool.poetry.dependencies] in pyproject.toml. Hash-pinned in runtime.txt
# so the container image installs nothing unpinned (OpenSSF Scorecard
# Pinned-Dependencies); the package itself goes on with --no-deps.
# Regenerate:
#   uv pip compile --generate-hashes --universal --python-version 3.11 \
#     requirements/runtime.in -o requirements/runtime.txt
