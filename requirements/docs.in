# Sphinx toolchain for .github/workflows/docs.yml on top of the runtime
# set (autodoc imports the package). Hash-pinned in docs.txt.
# Regenerate:
#   uv pip compile --generate-hashes --universal --python-version 3.10 \
#     requirements/docs.in -o requirements/docs.txt
-r runtime.in
sphinx
furo
myst-parser[linkify]
sphinx-autodoc-typehints
sphinx-copybutton
